# Your existing Mongo server (include user/pass if auth is on):
#   mongodb://user:pass@192.168.1.50:27017/?authSource=admin
MONGO_URI=mongodb://192.168.1.50:27017
MONGO_DB=wedding_flights

# Optional — enables true multi-city business tickets (DFW->DAD + Tokyo->DFW on one ticket).
# Free plan at https://serpapi.com is ~250 searches/month.
SERPAPI_KEY=

# Optional — password login. Generate with:  docker compose run --rm -it flight-tracker python -m app.auth
# Single-quote the values. Without APP_PASSWORD_HASH the dashboard stays open (as before) and the Claude features below stay OFF.
APP_PASSWORD_HASH=
SESSION_SECRET=

# Optional — "Ask Claude" tab (needs the login above). Points at the bridge running on the homelab Claude Code VM (see bridge/README.md).
CLAUDE_BRIDGE_URL=
CLAUDE_BRIDGE_TOKEN=
# Lets Claude manage destinations: the URL the bridge VM uses to reach this app (adds the /mcp tool endpoint).
APP_URL=
