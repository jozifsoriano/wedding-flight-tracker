# Your existing Mongo server (include user/pass if auth is on):
#   mongodb://user:pass@192.168.1.50:27017/?authSource=admin
MONGO_URI=mongodb://192.168.1.50:27017
MONGO_DB=wedding_flights

# Optional — enables true multi-city business tickets (DFW->DAD + Tokyo->DFW on one ticket).
# Free plan at https://serpapi.com is ~250 searches/month.
SERPAPI_KEY=
